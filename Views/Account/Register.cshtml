@model CollabNest.ViewModels.RegisterVM
@{
    ViewData["Title"] = "Create Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .auth-wrapper {
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: stretch;
    }

    /* ── Sidebar ── */
    .auth-sidebar {
        width: 340px;
        flex-shrink: 0;
        background: var(--bg-surface);
        border-right: 1px solid var(--border);
        padding: 2.5rem 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .auth-sidebar .sidebar-heading {
        font-family: 'Syne', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--accent-bright);
        margin-bottom: 0.85rem;
        padding-bottom: 0.65rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .sidebar-project-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 0.85rem 1rem;
        border-radius: var(--radius-md);
        border: 1px solid transparent;
        transition: background 0.2s, border-color 0.2s;
    }

    .sidebar-project-item:hover {
        background: var(--accent-dim);
        border-color: rgba(139,125,255,0.15);
    }

    .sidebar-proj-icon {
        width: 36px; height: 36px;
        border-radius: var(--radius-sm);
        background: var(--accent-dim);
        border: 1px solid rgba(139,125,255,0.2);
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
        color: var(--accent-bright);
    }

    .sidebar-proj-name {
        font-family: 'Syne', sans-serif;
        font-size: 0.84rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.3;
    }

    .sidebar-proj-sub {
        font-size: 0.76rem;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .sidebar-benefit {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 0.65rem 0;
        border-bottom: 1px solid var(--border);
    }

    .sidebar-benefit:last-child { border-bottom: none; }

    .sidebar-benefit-icon {
        width: 28px; height: 28px;
        border-radius: 50%;
        background: rgba(34,197,94,0.1);
        border: 1px solid rgba(34,197,94,0.2);
        display: flex; align-items: center; justify-content: center;
        color: #22c55e;
        font-size: 0.72rem;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .sidebar-benefit-text {
        font-size: 0.83rem;
        color: var(--text-secondary);
        line-height: 1.5;
    }

    .sidebar-benefit-text strong {
        color: var(--text-primary);
        font-weight: 600;
        display: block;
        font-size: 0.86rem;
    }

    /* ── Main form area ── */
    .auth-main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 2rem;
        background: var(--bg-base);
    }

    .auth-card {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 2.75rem 2.5rem;
        width: 100%;
        max-width: 460px;
        box-shadow: var(--shadow-card);
        position: relative;
        overflow: hidden;
    }

    .auth-card::before {
        content: '';
        position: absolute;
        width: 300px; height: 300px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(139,125,255,0.08) 0%, transparent 70%);
        top: -100px; right: -80px;
        pointer-events: none;
    }

    .auth-logo {
        width: 56px; height: 56px;
        border-radius: var(--radius-md);
        background: linear-gradient(135deg, var(--accent), var(--accent-bright));
        display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem;
        color: #fff;
        margin: 0 auto 1.5rem;
        box-shadow: 0 8px 24px rgba(139,125,255,0.35);
    }

    .auth-card h2 {
        font-family: 'Syne', sans-serif;
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--text-primary);
        text-align: center;
        margin-bottom: 0.35rem;
    }

    .auth-card .subtitle {
        color: var(--text-muted);
        font-size: 0.88rem;
        text-align: center;
        margin-bottom: 2rem;
    }

    .btn-auth {
        width: 100%;
        padding: 0.8rem;
        background: linear-gradient(135deg, var(--accent), var(--accent-bright));
        border: none;
        border-radius: var(--radius-sm);
        color: #fff;
        font-family: 'Syne', sans-serif;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s var(--ease-spring), box-shadow 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 0.5rem;
    }

    .btn-auth:hover { opacity: 0.9; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(139,125,255,0.4); }
    .btn-auth:active { transform: translateY(0); }

    .auth-footer-text {
        text-align: center;
        margin-top: 1.75rem;
        font-size: 0.87rem;
        color: var(--text-muted);
    }

    .auth-footer-text a { color: var(--accent-bright); font-weight: 600; text-decoration: none; transition: color 0.18s; }
    .auth-footer-text a:hover { color: var(--text-primary); }

    .pw-toggle-btn {
        background: var(--bg-elevated) !important;
        border: 1px solid var(--input-border) !important;
        color: var(--text-secondary) !important;
        border-left: none !important;
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0 !important;
        transition: color 0.18s !important;
    }

    .pw-toggle-btn:hover { color: var(--accent-bright) !important; }

    .terms-note {
        font-size: 0.76rem;
        color: var(--text-muted);
        text-align: center;
        margin-top: 1rem;
        line-height: 1.5;
    }

    .terms-note a { color: var(--accent-bright); text-decoration: none; }

    @@media (max-width: 768px) {
        .auth-sidebar { display: none; }
        .auth-main { padding: 2rem 1rem; }
        .auth-card { padding: 2rem 1.5rem; }
    }
</style>

<div class="auth-wrapper">

    <!-- ── Sidebar: Why Join ── -->
    <aside class="auth-sidebar">
        <div class="sidebar-heading">
            <i class="fas fa-rocket"></i>
            Why Join CollabNest?
        </div>

        <div class="sidebar-benefit">
            <div class="sidebar-benefit-icon"><i class="fas fa-check"></i></div>
            <div class="sidebar-benefit-text">
                <strong>Find real projects instantly</strong>
                Browse 140+ open projects looking for developers like you
            </div>
        </div>
        <div class="sidebar-benefit">
            <div class="sidebar-benefit-icon"><i class="fas fa-check"></i></div>
            <div class="sidebar-benefit-text">
                <strong>Build your portfolio</strong>
                Ship real products and add them to your professional portfolio
            </div>
        </div>
        <div class="sidebar-benefit">
            <div class="sidebar-benefit-icon"><i class="fas fa-check"></i></div>
            <div class="sidebar-benefit-text">
                <strong>Grow your network</strong>
                Connect with developers, designers, and creators from around the world
            </div>
        </div>
        <div class="sidebar-benefit">
            <div class="sidebar-benefit-icon"><i class="fas fa-check"></i></div>
            <div class="sidebar-benefit-text">
                <strong>Post your own projects</strong>
                Have an idea? Post it and find skilled collaborators to help you ship it
            </div>
        </div>
        <div class="sidebar-benefit">
            <div class="sidebar-benefit-icon"><i class="fas fa-check"></i></div>
            <div class="sidebar-benefit-text">
                <strong>100% free — always</strong>
                No hidden fees, no premium plans, no paywalls. Ever.
            </div>
        </div>
        <div class="sidebar-benefit">
            <div class="sidebar-benefit-icon"><i class="fas fa-check"></i></div>
            <div class="sidebar-benefit-text">
                <strong>Responsive on all devices</strong>
                Access CollabNest from desktop, tablet, or mobile — seamlessly
            </div>
        </div>

        <div style="margin-top:1.5rem;padding:1rem;background:var(--accent-dim);border:1px solid rgba(139,125,255,0.2);border-radius:var(--radius-md);">
            <div style="font-family:'Syne',sans-serif;font-size:0.82rem;font-weight:700;color:var(--accent-bright);margin-bottom:0.35rem;">
                <i class="fas fa-quote-left me-1" style="font-size:0.7rem;opacity:0.7;"></i>
                Join 800+ developers
            </div>
            <div style="font-size:0.8rem;color:var(--text-secondary);line-height:1.55;">
                Building the next wave of student and indie products — together.
            </div>
        </div>
    </aside>

    <!-- ── Register Form ── -->
    <div class="auth-main">
        <div class="auth-card">
            <div class="auth-logo"><i class="fas fa-user-plus"></i></div>
            <h2>Join CollabNest</h2>
            <p class="subtitle">Create your free account and start collaborating today</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Full Name</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input asp-for="Name" class="form-control" placeholder="Your full name" autocomplete="name" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger" style="font-size:0.78rem;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger" style="font-size:0.78rem;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Min 6 characters" id="regPwd" autocomplete="new-password" />
                        <button type="button" class="btn pw-toggle-btn" onclick="togglePwd('regPwd','regEye1')">
                            <i class="fas fa-eye" id="regEye1"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger" style="font-size:0.78rem;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" id="regPwd2" autocomplete="new-password" />
                        <button type="button" class="btn pw-toggle-btn" onclick="togglePwd('regPwd2','regEye2')">
                            <i class="fas fa-eye" id="regEye2"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.78rem;"></span>
                </div>

                <button type="submit" class="btn-auth">
                    <i class="fas fa-rocket"></i> Create My Account — It's Free
                </button>
            </form>

            <p class="terms-note">
                By creating an account you agree to our <a href="#" onclick="openPanel('privacy');return false;">Privacy Policy</a>
            </p>

            <p class="auth-footer-text">
                Already have an account? <a href="/Account/Login">Sign in &rarr;</a>
            </p>
        </div>
    </div>

</div>

<script>
function togglePwd(inputId, iconId) {
    const inp = document.getElementById(inputId);
    const ico = document.getElementById(iconId);
    if (inp.type === 'password') { inp.type = 'text'; ico.className = 'fas fa-eye-slash'; }
    else { inp.type = 'password'; ico.className = 'fas fa-eye'; }
}
</script>
