@model CollabNest.ViewModels.LoginVM
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .auth-wrapper {
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: stretch;
    }

    /* ── Sidebar ── */
    .auth-sidebar {
        width: 340px;
        flex-shrink: 0;
        background: var(--bg-surface);
        border-right: 1px solid var(--border);
        padding: 2.5rem 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .auth-sidebar .sidebar-heading {
        font-family: 'Syne', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--accent-bright);
        margin-bottom: 0.85rem;
        padding-bottom: 0.65rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .sidebar-project-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 0.85rem 1rem;
        border-radius: var(--radius-md);
        border: 1px solid transparent;
        cursor: default;
        transition: background 0.2s, border-color 0.2s;
    }

    .sidebar-project-item:hover {
        background: var(--accent-dim);
        border-color: rgba(139,125,255,0.15);
    }

    .sidebar-proj-icon {
        width: 36px; height: 36px;
        border-radius: var(--radius-sm);
        background: var(--accent-dim);
        border: 1px solid rgba(139,125,255,0.2);
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
        color: var(--accent-bright);
    }

    .sidebar-proj-name {
        font-family: 'Syne', sans-serif;
        font-size: 0.84rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.3;
    }

    .sidebar-proj-sub {
        font-size: 0.76rem;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .sidebar-stat-row {
        display: flex;
        gap: 0.5rem;
        margin-top: 1.5rem;
    }

    .sidebar-stat {
        flex: 1;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 0.75rem;
        text-align: center;
    }

    .sidebar-stat .num {
        font-family: 'Syne', sans-serif;
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--accent-bright);
    }

    .sidebar-stat .lbl {
        font-size: 0.7rem;
        color: var(--text-muted);
        margin-top: 2px;
    }

    /* ── Main form area ── */
    .auth-main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 2rem;
        background: var(--bg-base);
    }

    .auth-card {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 2.75rem 2.5rem;
        width: 100%;
        max-width: 440px;
        box-shadow: var(--shadow-card);
        position: relative;
        overflow: hidden;
    }

    .auth-card::before {
        content: '';
        position: absolute;
        width: 300px; height: 300px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(139,125,255,0.08) 0%, transparent 70%);
        top: -100px; right: -80px;
        pointer-events: none;
    }

    .auth-logo {
        width: 56px; height: 56px;
        border-radius: var(--radius-md);
        background: linear-gradient(135deg, var(--accent), var(--accent-bright));
        display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem;
        color: #fff;
        margin: 0 auto 1.5rem;
        box-shadow: 0 8px 24px rgba(139,125,255,0.35);
    }

    .auth-card h2 {
        font-family: 'Syne', sans-serif;
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--text-primary);
        text-align: center;
        margin-bottom: 0.35rem;
    }

    .auth-card .subtitle {
        color: var(--text-muted);
        font-size: 0.88rem;
        text-align: center;
        margin-bottom: 2rem;
    }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 1.5rem 0;
        color: var(--text-muted);
        font-size: 0.78rem;
    }

    .auth-divider::before, .auth-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border);
    }

    .btn-auth {
        width: 100%;
        padding: 0.8rem;
        background: linear-gradient(135deg, var(--accent), var(--accent-bright));
        border: none;
        border-radius: var(--radius-sm);
        color: #fff;
        font-family: 'Syne', sans-serif;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s var(--ease-spring), box-shadow 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        letter-spacing: 0.3px;
    }

    .btn-auth:hover {
        opacity: 0.9;
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(139,125,255,0.4);
    }

    .btn-auth:active { transform: translateY(0); }

    .forgot-link {
        display: block;
        text-align: right;
        color: var(--accent-bright);
        font-size: 0.8rem;
        font-weight: 500;
        text-decoration: none;
        margin-top: 0.4rem;
        transition: color 0.18s;
    }

    .forgot-link:hover { color: var(--text-primary); }

    .auth-footer-text {
        text-align: center;
        margin-top: 1.75rem;
        font-size: 0.87rem;
        color: var(--text-muted);
    }

    .auth-footer-text a {
        color: var(--accent-bright);
        font-weight: 600;
        text-decoration: none;
        transition: color 0.18s;
    }

    .auth-footer-text a:hover { color: var(--text-primary); }

    .pw-toggle-btn {
        background: var(--bg-elevated) !important;
        border: 1px solid var(--input-border) !important;
        color: var(--text-secondary) !important;
        border-left: none !important;
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0 !important;
        transition: color 0.18s !important;
    }

    .pw-toggle-btn:hover { color: var(--accent-bright) !important; }

    @@media (max-width: 768px) {
        .auth-sidebar { display: none; }
        .auth-main { padding: 2rem 1rem; }
        .auth-card { padding: 2rem 1.5rem; }
    }
</style>

<div class="auth-wrapper">

    <!-- ── Sidebar: Project list ── -->
    <aside class="auth-sidebar">
        <div class="sidebar-heading">
            <i class="fas fa-code-branch"></i>
            CollabNest Projects
        </div>

        <div class="sidebar-project-item">
            <div class="sidebar-proj-icon"><i class="fas fa-robot"></i></div>
            <div>
                <div class="sidebar-proj-name">AI Study Assistant</div>
                <div class="sidebar-proj-sub">React · Python · NLP</div>
            </div>
        </div>
        <div class="sidebar-project-item">
            <div class="sidebar-proj-icon"><i class="fas fa-store"></i></div>
            <div>
                <div class="sidebar-proj-name">E-Commerce Platform</div>
                <div class="sidebar-proj-sub">Node.js · MongoDB · Stripe</div>
            </div>
        </div>
        <div class="sidebar-project-item">
            <div class="sidebar-proj-icon"><i class="fas fa-heartbeat"></i></div>
            <div>
                <div class="sidebar-proj-name">HealthTrack App</div>
                <div class="sidebar-proj-sub">Flutter · Firebase · REST</div>
            </div>
        </div>
        <div class="sidebar-project-item">
            <div class="sidebar-proj-icon"><i class="fas fa-gamepad"></i></div>
            <div>
                <div class="sidebar-proj-name">Multiplayer Word Game</div>
                <div class="sidebar-proj-sub">Socket.IO · Vue · Redis</div>
            </div>
        </div>
        <div class="sidebar-project-item">
            <div class="sidebar-proj-icon"><i class="fas fa-leaf"></i></div>
            <div>
                <div class="sidebar-proj-name">Carbon Footprint Tracker</div>
                <div class="sidebar-proj-sub">Next.js · Supabase · Charts</div>
            </div>
        </div>
        <div class="sidebar-project-item">
            <div class="sidebar-proj-icon"><i class="fas fa-graduation-cap"></i></div>
            <div>
                <div class="sidebar-proj-name">LMS for Students</div>
                <div class="sidebar-proj-sub">ASP.NET Core · SQL Server</div>
            </div>
        </div>

        <div class="sidebar-stat-row">
            <div class="sidebar-stat">
                <div class="num">140+</div>
                <div class="lbl">Projects</div>
            </div>
            <div class="sidebar-stat">
                <div class="num">800+</div>
                <div class="lbl">Members</div>
            </div>
            <div class="sidebar-stat">
                <div class="num">Free</div>
                <div class="lbl">Always</div>
            </div>
        </div>
    </aside>

    <!-- ── Login Form ── -->
    <div class="auth-main">
        <div class="auth-card">
            <div class="auth-logo"><i class="fas fa-sign-in-alt"></i></div>
            <h2>Welcome Back</h2>
            <p class="subtitle">Sign in to your CollabNest account to continue</p>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3 mb-3" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none");"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="off" id="loginEmail" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger" style="font-size:0.78rem;"></span>
                </div>

                <div class="mb-1">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Your password" id="loginPwd" autocomplete="current-password" />
                        <button type="button" class="btn pw-toggle-btn" onclick="togglePwd('loginPwd','loginEye')">
                            <i class="fas fa-eye" id="loginEye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger" style="font-size:0.78rem;"></span>
                </div>

                <a href="/Account/ForgotPassword" class="forgot-link">Forgot password?</a>

                <div class="auth-divider">or continue with</div>

                <button type="submit" class="btn-auth">
                    <i class="fas fa-sign-in-alt"></i> Sign In to CollabNest
                </button>
            </form>

            <p class="auth-footer-text">
                Don't have an account? <a href="/Account/Register">Create one free &rarr;</a>
            </p>
        </div>
    </div>

</div>

<style>
    .autofill-dropdown {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        box-shadow: 0 8px 24px rgba(0,0,0,0.25);
        z-index: 9999;
        overflow: hidden;
        display: none;
    }
    .autofill-dropdown.show { display: block; }
    .autofill-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        cursor: pointer;
        transition: background 0.15s;
        font-size: 0.88rem;
        color: var(--text-primary);
    }
    .autofill-item:hover, .autofill-item.active {
        background: var(--accent-dim);
    }
    .autofill-item i {
        color: var(--accent-bright);
        width: 16px;
        text-align: center;
        flex-shrink: 0;
    }
    .autofill-item .email-text { flex: 1; }
    .autofill-item .name-text {
        font-size: 0.75rem;
        color: var(--text-muted);
    }
    .autofill-wrapper { position: relative; }
</style>

<script>
function togglePwd(inputId, iconId) {
    const inp = document.getElementById(inputId);
    const ico = document.getElementById(iconId);
    if (inp.type === 'password') { inp.type = 'text'; ico.className = 'fas fa-eye-slash'; }
    else { inp.type = 'password'; ico.className = 'fas fa-eye'; }
}

// ── Smart Autofill Suggestion (Google-style) ──
(function () {
    const STORAGE_KEY = 'cn_saved_emails';

    function getSavedEmails() {
        try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
        catch { return []; }
    }

    function saveEmail(email) {
        if (!email || !email.includes('@@')) return;
        let list = getSavedEmails();
        list = [email, ...list.filter(e => e !== email)].slice(0, 8);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
    }

    function buildDropdown(emailInput) {
        const wrapper = emailInput.closest('.autofill-wrapper') || emailInput.parentElement;
        let dropdown = wrapper.querySelector('.autofill-dropdown');
        if (!dropdown) {
            dropdown = document.createElement('div');
            dropdown.className = 'autofill-dropdown';
            wrapper.appendChild(dropdown);
        }
        return dropdown;
    }

    function renderSuggestions(dropdown, matches, emailInput, pwdInput) {
        dropdown.innerHTML = '';
        if (!matches.length) { dropdown.classList.remove('show'); return; }
        matches.forEach((email, idx) => {
            const item = document.createElement('div');
            item.className = 'autofill-item';
            item.innerHTML = `<i class="fas fa-user-circle"></i><span class="email-text">${email}</span>`;
            item.addEventListener('mousedown', e => {
                e.preventDefault();
                emailInput.value = email;
                dropdown.classList.remove('show');
                if (pwdInput) pwdInput.focus();
            });
            dropdown.appendChild(item);
        });
        dropdown.classList.add('show');
    }

    document.addEventListener('DOMContentLoaded', function () {
        const emailInput = document.getElementById('loginEmail');
        const pwdInput  = document.getElementById('loginPwd');
        if (!emailInput) return;

        // Wrap input group for positioning
        const inputGroup = emailInput.closest('.input-group');
        if (inputGroup) {
            inputGroup.style.position = 'relative';
        }

        const dropdown = buildDropdown(emailInput);

        // Show all saved emails on focus
        emailInput.addEventListener('focus', function () {
            const saved = getSavedEmails();
            const val   = this.value.trim().toLowerCase();
            const matches = val ? saved.filter(e => e.toLowerCase().includes(val)) : saved;
            renderSuggestions(dropdown, matches, emailInput, pwdInput);
        });

        // Filter as user types
        emailInput.addEventListener('input', function () {
            const val = this.value.trim().toLowerCase();
            const saved = getSavedEmails();
            const matches = val ? saved.filter(e => e.toLowerCase().includes(val)) : saved;
            renderSuggestions(dropdown, matches, emailInput, pwdInput);
        });

        // Hide on outside click
        document.addEventListener('mousedown', function (e) {
            if (!emailInput.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.remove('show');
            }
        });

        // Save email on successful form submit
        const form = emailInput.closest('form');
        if (form) {
            form.addEventListener('submit', function () {
                saveEmail(emailInput.value.trim());
            });
        }
    });
})();
</script>