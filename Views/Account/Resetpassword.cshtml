@model CollabNest.ViewModels.ResetPasswordVM
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<style>
    .auth-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    .auth-card {
        width: 100%;
        max-width: 420px;
        background: rgba(13, 21, 38, 0.72);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 24px 64px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.06);
        padding: 40px 36px 36px;
    }

    .auth-icon {
        width: 52px;
        height: 52px;
        background: linear-gradient(135deg, rgba(139,125,255,0.2), rgba(184,174,253,0.1));
        border: 1px solid rgba(139,125,255,0.3);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 20px;
    }

    .auth-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #eef0f7;
        margin: 0 0 6px;
        letter-spacing: -0.4px;
    }

    .auth-sub {
        font-size: 0.88rem;
        color: #6b7a99;
        margin: 0 0 28px;
        line-height: 1.55;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #8a95b0;
        margin-bottom: 7px;
    }

    .input-wrap {
        position: relative;
    }

    .form-control {
        width: 100%;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.09);
        border-radius: 10px;
        padding: 12px 44px 12px 14px;
        color: #eef0f7;
        font-size: 0.92rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: rgba(139,125,255,0.5);
        box-shadow: 0 0 0 3px rgba(139,125,255,0.12);
        background: rgba(255,255,255,0.06);
    }

    .form-control::placeholder { color: #3d4d6a; }

    .toggle-pw {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #4a5568;
        cursor: pointer;
        font-size: 1rem;
        padding: 0;
        line-height: 1;
        transition: color 0.15s;
    }

    .toggle-pw:hover { color: #8b7dff; }

    .field-validation-error {
        display: block;
        font-size: 0.78rem;
        color: #f87171;
        margin-top: 5px;
    }

    /* Password strength bar */
    .strength-wrap {
        margin-top: 8px;
        display: flex;
        gap: 4px;
        align-items: center;
    }

    .strength-bar {
        flex: 1;
        height: 4px;
        border-radius: 99px;
        background: rgba(255,255,255,0.07);
        transition: background 0.3s;
    }

    .strength-label {
        font-size: 0.72rem;
        font-weight: 600;
        color: #4a5568;
        min-width: 44px;
        text-align: right;
        transition: color 0.3s;
    }

    .btn-primary {
        width: 100%;
        padding: 13px;
        background: linear-gradient(135deg, #8b7dff, #b8aefd);
        border: none;
        border-radius: 11px;
        color: #fff;
        font-size: 0.93rem;
        font-weight: 700;
        cursor: pointer;
        letter-spacing: 0.3px;
        transition: opacity 0.2s, transform 0.15s;
        margin-top: 6px;
    }

    .btn-primary:hover { opacity: 0.9; transform: translateY(-1px); }
    .btn-primary:active { transform: translateY(0); }

    .auth-footer {
        text-align: center;
        margin-top: 22px;
        font-size: 0.83rem;
        color: #4a5568;
    }

    .auth-footer a {
        color: #8b7dff;
        text-decoration: none;
        font-weight: 600;
    }

    .auth-footer a:hover { text-decoration: underline; }
</style>

<div class="auth-wrap">
    <div class="auth-card">

        <div class="auth-icon">🔒</div>
        <h1 class="auth-title">Set new password</h1>
        <p class="auth-sub">Choose a strong password for your CollabNest account.</p>

        <form asp-action="ResetPassword" method="post" novalidate>
            @Html.AntiForgeryToken()

            @* Hidden fields — carry token & email through form *@
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div class="form-group">
                <label class="form-label">New password</label>
                <div class="input-wrap">
                    <input asp-for="NewPassword" id="pwField" class="form-control"
                           type="password" placeholder="Min. 8 characters" autocomplete="new-password" />
                    <button type="button" class="toggle-pw" onclick="togglePw('pwField', this)" tabindex="-1">👁</button>
                </div>
                <div class="strength-wrap">
                    <div class="strength-bar" id="sb1"></div>
                    <div class="strength-bar" id="sb2"></div>
                    <div class="strength-bar" id="sb3"></div>
                    <div class="strength-bar" id="sb4"></div>
                    <span class="strength-label" id="slabel"></span>
                </div>
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Confirm new password</label>
                <div class="input-wrap">
                    <input asp-for="ConfirmPassword" id="cpwField" class="form-control"
                           type="password" placeholder="Repeat password" autocomplete="new-password" />
                    <button type="button" class="toggle-pw" onclick="togglePw('cpwField', this)" tabindex="-1">👁</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-primary">Reset password →</button>
        </form>

        <div class="auth-footer">
            <a asp-action="Login">← Back to login</a>
        </div>
    </div>
</div>

<script>
    // Toggle password visibility
    function togglePw(fieldId, btn) {
        const f = document.getElementById(fieldId);
        f.type = f.type === 'password' ? 'text' : 'password';
        btn.textContent = f.type === 'password' ? '👁' : '🙈';
    }

    // Strength meter
    document.getElementById('pwField').addEventListener('input', function () {
        const v = this.value;
        let score = 0;
        if (v.length >= 8)  score++;
        if (/[A-Z]/.test(v)) score++;
        if (/[0-9]/.test(v)) score++;
        if (/[^A-Za-z0-9]/.test(v)) score++;

        const colours = ['', '#f87171', '#fbbf24', '#34d399', '#8b7dff'];
        const labels  = ['', 'Weak', 'Fair', 'Good', 'Strong'];

        for (let i = 1; i <= 4; i++) {
            document.getElementById('sb' + i).style.background =
                i <= score ? colours[score] : 'rgba(255,255,255,0.07)';
        }

        const sl = document.getElementById('slabel');
        sl.textContent  = labels[score] || '';
        sl.style.color  = colours[score] || '#4a5568';
    });
</script>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
