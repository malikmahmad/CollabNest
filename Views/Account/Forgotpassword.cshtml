@model CollabNest.ViewModels.ForgotPasswordVM
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<style>
    .auth-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    .auth-card {
        width: 100%;
        max-width: 420px;
        background: rgba(13, 21, 38, 0.72);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 24px 64px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.06);
        padding: 40px 36px 36px;
    }

    .auth-icon {
        width: 52px;
        height: 52px;
        background: linear-gradient(135deg, rgba(139,125,255,0.2), rgba(184,174,253,0.1));
        border: 1px solid rgba(139,125,255,0.3);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 20px;
    }

    .auth-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #eef0f7;
        margin: 0 0 6px;
        letter-spacing: -0.4px;
    }

    .auth-sub {
        font-size: 0.88rem;
        color: #6b7a99;
        margin: 0 0 28px;
        line-height: 1.55;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        display: block;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #8a95b0;
        margin-bottom: 7px;
    }

    .form-control {
        width: 100%;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.09);
        border-radius: 10px;
        padding: 12px 14px;
        color: #eef0f7;
        font-size: 0.92rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: rgba(139,125,255,0.5);
        box-shadow: 0 0 0 3px rgba(139,125,255,0.12);
        background: rgba(255,255,255,0.06);
    }

    .form-control::placeholder { color: #3d4d6a; }

    .field-validation-error {
        display: block;
        font-size: 0.78rem;
        color: #f87171;
        margin-top: 5px;
    }

    .btn-primary {
        width: 100%;
        padding: 13px;
        background: linear-gradient(135deg, #8b7dff, #b8aefd);
        border: none;
        border-radius: 11px;
        color: #fff;
        font-size: 0.93rem;
        font-weight: 700;
        cursor: pointer;
        letter-spacing: 0.3px;
        transition: opacity 0.2s, transform 0.15s;
        margin-top: 6px;
    }

    .btn-primary:hover { opacity: 0.9; transform: translateY(-1px); }
    .btn-primary:active { transform: translateY(0); }

    .auth-footer {
        text-align: center;
        margin-top: 22px;
        font-size: 0.83rem;
        color: #4a5568;
    }

    .auth-footer a {
        color: #8b7dff;
        text-decoration: none;
        font-weight: 600;
    }

    .auth-footer a:hover { text-decoration: underline; }

    .hint-box {
        background: rgba(139,125,255,0.07);
        border: 1px solid rgba(139,125,255,0.18);
        border-radius: 10px;
        padding: 12px 14px;
        margin-bottom: 20px;
        font-size: 0.82rem;
        color: #8a95b0;
        line-height: 1.55;
    }
</style>

<div class="auth-wrap">
    <div class="auth-card">

        <div class="auth-icon">🔑</div>
        <h1 class="auth-title">Forgot password?</h1>
        <p class="auth-sub">No worries — enter your email and we'll send you a reset link.</p>

        <div class="hint-box">
            📬 The reset link expires in <strong style="color:#b8aefd;">1 hour</strong>. Check your inbox and spam folder.
        </div>

        <form asp-action="ForgotPassword" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-primary">Send reset link →</button>
        </form>

        <div class="auth-footer">
            Remembered it? <a asp-action="Login">Back to login</a>
        </div>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
