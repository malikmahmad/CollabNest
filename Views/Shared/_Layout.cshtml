<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
<script>
    /* ─── Theme System ─── */
    const root = document.documentElement;

    function getSystemTheme() {
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }

    function applyTheme(theme) {
        const resolved = theme === 'system' ? getSystemTheme() : theme;
        root.setAttribute('data-theme', resolved);

        const icons  = { dark: 'fa-moon', light: 'fa-sun', system: 'fa-circle-half-stroke' };
        const labels = { dark: 'Dark',    light: 'Light',  system: 'Auto' };

        const iconEl  = document.getElementById('themeIcon');
        const labelEl = document.getElementById('themeLabel');
        if (iconEl)  iconEl.className  = 'fas ' + (icons[theme]  || 'fa-moon');
        if (labelEl) labelEl.textContent = labels[theme] || 'Dark';

        ['dark', 'light', 'system'].forEach(t => {
            const check = document.getElementById('check-' + t);
            if (check) check.classList.toggle('visible', t === theme);
        });
    }

    function setTheme(theme) {
        localStorage.setItem('cn-theme', theme);
        applyTheme(theme);
    }

    (function () {
        const saved = localStorage.getItem('cn-theme') || 'dark';
        applyTheme(saved);
    })();

    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', function () {
        if ((localStorage.getItem('cn-theme') || 'dark') === 'system') {
            applyTheme('system');
        }
    });

    /* ─── Panel System ─── */
    function openPanel(name) {
        document.querySelectorAll('.page-panel.active').forEach(p => p.classList.remove('active'));
        const panel = document.getElementById('panel-' + name);
        if (!panel) return;
        panel.classList.add('active');
        panel.scrollTop = 0;
        document.body.style.overflow = 'hidden';
        document.querySelectorAll('#mainNav .nav-center .nav-link').forEach(l => l.classList.remove('active'));
        const link = document.querySelector(`#mainNav .nav-center .nav-link[onclick*="${name}"]`);
        if (link) link.classList.add('active');
    }

    function closePanel(name) {
        const panel = document.getElementById('panel-' + name);
        if (!panel) return;
        const inner    = panel.querySelector('.page-panel-inner');
        const backdrop = panel.querySelector('.panel-backdrop');
        if (inner)    { inner.style.transform = 'translateY(20px)'; inner.style.opacity = '0'; }
        if (backdrop) { backdrop.style.opacity = '0'; }
        setTimeout(() => {
            panel.classList.remove('active');
            if (inner)    { inner.style.transform = ''; inner.style.opacity = ''; }
            if (backdrop) { backdrop.style.opacity = ''; }
            document.body.style.overflow = '';
            document.querySelectorAll('#mainNav .nav-center .nav-link').forEach(l => l.classList.remove('active'));
        }, 300);
    }

    function closePanelFromBackdrop(event, name) {
        if (event.target === event.currentTarget) closePanel(name);
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            document.querySelectorAll('.page-panel.active').forEach(p => {
                closePanel(p.id.replace('panel-', ''));
            });
        }
    });

    /* ─── FAQ Accordion ─── */
    function toggleFaq(btn) {
        const item   = btn.closest('.faq-item');
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(i => i.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
    }
</script>
    @{ await Html.RenderPartialAsync("_ToastAlerts"); }
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    @RenderSection("Scripts", required: false)
</body>
</html>
