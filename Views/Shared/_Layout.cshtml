<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CollabNest</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="~/icon.svg" />
    <link rel="shortcut icon" href="~/icon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>

        /* ══════════════════════════════════════
           THEME VARIABLES
        ══════════════════════════════════════ */
        :root,
        [data-theme="dark"] {
            --bg-base:        #070b18;
            --bg-surface:     #0d1526;
            --bg-elevated:    #111c33;
            --bg-card:        rgba(255,255,255,0.035);
            --border:         rgba(255,255,255,0.07);
            --border-hover:   rgba(148,130,255,0.35);
            --accent:         #8b7dff;
            --accent-bright:  #b8aefd;
            --accent-dim:     rgba(139,125,255,0.12);
            --text-primary:   #eef0f7;
            --text-secondary: #8a95b0;
            --text-muted:     #465070;
            --white:          #ffffff;
            --danger:         #f43f5e;
            --success:        #22c55e;
            --radius-sm:      8px;
            --radius-md:      12px;
            --radius-lg:      18px;
            --radius-xl:      24px;
            --ease-out:       cubic-bezier(0.16, 1, 0.3, 1);
            --ease-spring:    cubic-bezier(0.34, 1.56, 0.64, 1);
            --shadow-glow:    0 0 40px rgba(139,125,255,0.15);
            --shadow-card:    0 4px 24px rgba(0,0,0,0.4);
            --nav-bg:         rgba(7,11,24,0.85);
            --input-bg:       rgba(255,255,255,0.04);
            --input-border:   rgba(255,255,255,0.1);
            --input-text:     #eef0f7;
        }

        [data-theme="light"] {
            --bg-base:        #f4f6fc;
            --bg-surface:     #ffffff;
            --bg-elevated:    #f0f2fb;
            --bg-card:        rgba(255,255,255,0.85);
            --border:         rgba(0,0,0,0.09);
            --border-hover:   rgba(139,125,255,0.4);
            --accent:         #6c5ce7;
            --accent-bright:  #8b7dff;
            --accent-dim:     rgba(108,92,231,0.10);
            --text-primary:   #1a1d2e;
            --text-secondary: #4a5068;
            --text-muted:     #7a849e;
            --white:          #1a1d2e;
            --danger:         #e11d48;
            --success:        #16a34a;
            --shadow-glow:    0 0 40px rgba(108,92,231,0.10);
            --shadow-card:    0 4px 24px rgba(0,0,0,0.08);
            --nav-bg:         rgba(255,255,255,0.90);
            --input-bg:       #f8f9ff;
            --input-border:   rgba(0,0,0,0.12);
            --input-text:     #1a1d2e;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg-base);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            transition: background 0.3s ease, color 0.3s ease;
        }

        /* ══════════════════════════════════════
           NAVBAR
        ══════════════════════════════════════ */
        #mainNav {
            background: var(--nav-bg);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border-bottom: 1px solid var(--border);
            padding: 0.6rem 0;
            position: sticky;
            top: 0;
            z-index: 1050;
            transition: background 0.3s;
        }

        #mainNav .navbar-brand {
            font-family: 'Syne', sans-serif;
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--text-primary);
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        #mainNav .navbar-brand .brand-icon {
            width: 32px; height: 32px;
            background: linear-gradient(135deg, var(--accent), var(--accent-bright));
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.85rem;
            color: #fff;
            flex-shrink: 0;
        }

        .nav-center {
            display: flex;
            flex-direction: row;
            flex-wrap: nowrap;
            align-items: center;
            gap: 2px;
        }

        .nav-center .nav-link {
            color: var(--text-secondary) !important;
            font-size: 0.83rem;
            font-weight: 500;
            padding: 0.4rem 0.65rem !important;
            white-space: nowrap;
            border-radius: var(--radius-sm);
            transition: color 0.2s, background 0.2s;
            position: relative;
        }

        .nav-center .nav-link:hover,
        .nav-center .nav-link.active {
            color: var(--accent-bright) !important;
            background: var(--accent-dim);
        }

        .nav-center .nav-link.nav-home {
            color: var(--text-primary) !important;
            font-weight: 600;
        }

        /* ── nav Login link style ── */
        .nav-center .nav-link.nav-login {
            color: var(--text-secondary) !important;
            font-size: 0.83rem;
            font-weight: 500;
        }

        .nav-center .nav-link.nav-login:hover {
            color: var(--accent-bright) !important;
            background: var(--accent-dim);
        }

        /* ══════════════════════════════════════
           THEME DROPDOWN
        ══════════════════════════════════════ */
        .theme-dropdown-btn {
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--bg-elevated);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text-secondary);
            padding: 5px 11px;
            font-size: 0.82rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s, border-color 0.2s, color 0.2s;
            white-space: nowrap;
            line-height: 1;
        }

        .theme-dropdown-btn:hover {
            background: var(--accent-dim);
            border-color: var(--border-hover);
            color: var(--text-primary);
        }

        .theme-dropdown-btn i { font-size: 0.78rem; }
        .theme-dropdown-btn::after { margin-left: 2px; opacity: 0.5; font-size: 0.7rem; }

        .theme-dropdown-menu {
            min-width: 155px !important;
            padding: 0.35rem !important;
        }

        .theme-option {
            display: flex !important;
            align-items: center;
            gap: 9px;
            width: 100%;
            font-size: 0.85rem !important;
        }

        .theme-option .t-icon {
            font-size: 0.78rem;
            width: 15px;
            text-align: center;
            color: var(--accent-bright);
            flex-shrink: 0;
        }

        .theme-check {
            margin-left: auto;
            font-size: 0.68rem;
            color: var(--accent-bright);
            opacity: 0;
            transition: opacity 0.15s;
        }

        .theme-check.visible { opacity: 1; }

        /* ══════════════════════════════════════
           USER AVATAR & DROPDOWN
        ══════════════════════════════════════ */
        .user-avatar-pro {
            width: 32px; height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-bright));
            display: flex; align-items: center; justify-content: center;
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            font-size: 0.82rem;
            color: #fff;
            flex-shrink: 0;
            border: 2px solid rgba(139,125,255,0.3);
            box-shadow: 0 0 0 3px var(--accent-dim);
            transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s var(--ease-spring);
        }

        .user-avatar-pro.lg {
            width: 42px; height: 42px;
            font-size: 1.05rem;
        }

        .user-dropdown-toggle:hover .user-avatar-pro,
        .user-dropdown-toggle.show .user-avatar-pro {
            border-color: var(--accent);
            box-shadow: 0 0 0 4px rgba(139,125,255,0.2);
            transform: scale(1.05);
        }

        .user-dropdown-toggle::after { display: none !important; }

        .user-chevron {
            font-size: 0.6rem;
            color: var(--text-muted);
            transition: transform 0.2s;
        }

        .user-dropdown-toggle.show .user-chevron {
            transform: rotate(180deg);
        }

        .user-dropdown-menu {
            min-width: 220px !important;
            padding: 0 !important;
            overflow: hidden;
        }

        .user-dropdown-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.85rem 0.9rem 0.75rem;
            background: var(--accent-dim);
            border-bottom: 1px solid var(--border);
        }

        .user-dropdown-header .user-name {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.2;
        }

        .user-dropdown-header .user-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 0.68rem;
            font-weight: 600;
            color: var(--accent-bright);
            margin-top: 2px;
        }

        .user-dropdown-body {
            padding: 0.35rem;
        }

        .user-dropdown-menu .dropdown-item {
            display: flex !important;
            align-items: center;
            gap: 9px;
            border-radius: var(--radius-sm) !important;
            font-size: 0.85rem !important;
            padding: 0.55rem 0.75rem !important;
        }

        .user-dropdown-menu .dropdown-item .di-icon {
            width: 28px; height: 28px;
            border-radius: 7px;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.75rem;
            flex-shrink: 0;
        }

        .user-dropdown-menu .dropdown-item .di-icon.purple {
            background: var(--accent-dim);
            color: var(--accent-bright);
        }

        .user-dropdown-menu .dropdown-item .di-icon.green {
            background: rgba(34,197,94,0.1);
            color: #22c55e;
        }

        .user-dropdown-menu .dropdown-item .di-icon.amber {
            background: rgba(245,158,11,0.1);
            color: #f59e0b;
        }

        .user-dropdown-menu .dropdown-item .di-icon.red {
            background: rgba(244,63,94,0.1);
            color: var(--danger);
        }

        .user-dropdown-menu .dropdown-item:hover .di-icon.purple { background: rgba(139,125,255,0.2); }
        .user-dropdown-menu .dropdown-item:hover .di-icon.green  { background: rgba(34,197,94,0.18); }
        .user-dropdown-menu .dropdown-item:hover .di-icon.amber  { background: rgba(245,158,11,0.18); }
        .user-dropdown-menu .dropdown-item:hover .di-icon.red    { background: rgba(244,63,94,0.18); }

        .logout-item { color: var(--danger) !important; }
        .logout-item:hover { background: rgba(244,63,94,0.08) !important; }

        .user-dropdown-footer {
            padding: 0.5rem 0.9rem 0.65rem;
            border-top: 1px solid var(--border);
            font-size: 0.68rem;
            color: var(--text-muted);
            text-align: center;
        }

        /* ══════════════════════════════════════
           OVERLAY PANEL SYSTEM
        ══════════════════════════════════════ */
        .page-panel {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 1040;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .page-panel.active { display: block; }

        .panel-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(4, 7, 18, 0.75);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 1;
            opacity: 0;
            transition: opacity 0.35s var(--ease-out);
        }

        .page-panel.active .panel-backdrop { opacity: 1; }

        .page-panel-inner {
            position: relative;
            z-index: 2;
            background: var(--bg-surface);
            min-height: 100vh;
            color: var(--text-primary);
            transform: translateY(30px);
            opacity: 0;
            transition: transform 0.4s var(--ease-out), opacity 0.35s ease;
        }

        .page-panel.active .page-panel-inner {
            transform: translateY(0);
            opacity: 1;
            transition-delay: 0.05s;
        }

        .panel-topbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background: var(--bg-surface);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            padding: 0.85rem 1.75rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .panel-topbar .brand {
            font-family: 'Syne', sans-serif;
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--accent-bright);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .panel-close {
            background: rgba(255,255,255,0.06);
            border: 1px solid var(--border);
            color: var(--text-secondary);
            border-radius: var(--radius-sm);
            width: 36px; height: 36px;
            font-size: 0.95rem;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.15s;
        }

        .panel-close:hover {
            background: rgba(244,63,94,0.12);
            border-color: rgba(244,63,94,0.3);
            color: var(--danger);
            transform: scale(1.05);
        }

        /* ══════════════════════════════════════
           PANEL HERO
        ══════════════════════════════════════ */
        .panel-hero {
            background: linear-gradient(160deg, var(--bg-base) 0%, var(--bg-elevated) 55%, var(--bg-base) 100%);
            padding: 90px 0 70px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .panel-hero::before {
            content: '';
            position: absolute;
            width: 600px; height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(139,125,255,0.14) 0%, transparent 65%);
            top: -150px; left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
        }

        .panel-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--accent-dim);
            border: 1px solid rgba(139,125,255,0.25);
            border-radius: 30px;
            padding: 5px 18px;
            font-size: 0.73rem;
            font-weight: 600;
            color: var(--accent-bright);
            margin-bottom: 22px;
            letter-spacing: 1px;
            text-transform: uppercase;
            position: relative;
            z-index: 1;
        }

        .panel-hero h1 {
            font-family: 'Syne', sans-serif;
            font-size: clamp(2rem, 5vw, 3.4rem);
            font-weight: 800;
            color: var(--text-primary);
            line-height: 1.12;
            margin-bottom: 1.1rem;
            position: relative;
            z-index: 1;
        }

        .panel-hero h1 span { color: var(--accent-bright); }

        .panel-hero p {
            font-size: 1.08rem;
            color: var(--text-secondary);
            max-width: 560px;
            margin: 0 auto;
            line-height: 1.75;
            position: relative;
            z-index: 1;
        }

        /* ══════════════════════════════════════
           CARDS
        ══════════════════════════════════════ */
        .content-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            transition: border-color 0.25s, transform 0.25s var(--ease-out), box-shadow 0.25s;
            height: 100%;
        }

        .content-card:hover {
            border-color: var(--border-hover);
            transform: translateY(-4px);
            box-shadow: var(--shadow-glow), var(--shadow-card);
        }

        .content-card .icon-wrap {
            width: 50px; height: 50px;
            border-radius: var(--radius-md);
            background: var(--accent-dim);
            border: 1px solid rgba(139,125,255,0.2);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem;
            color: var(--accent-bright);
            margin-bottom: 1.1rem;
            transition: background 0.2s, transform 0.2s var(--ease-spring);
        }

        .content-card:hover .icon-wrap {
            background: rgba(139,125,255,0.2);
            transform: scale(1.08);
        }

        .content-card h5 {
            font-family: 'Syne', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
        }

        .content-card p {
            font-size: 0.875rem;
            color: var(--text-muted);
            line-height: 1.7;
            margin: 0;
        }

        .step-card {
            display: flex;
            gap: 1.1rem;
            align-items: flex-start;
            padding: 1.4rem 1.5rem;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            margin-bottom: 0.85rem;
            transition: border-color 0.22s, transform 0.22s var(--ease-out);
        }

        .step-card:hover {
            border-color: var(--border-hover);
            transform: translateX(5px);
        }

        .step-num {
            min-width: 38px; height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-bright));
            display: flex; align-items: center; justify-content: center;
            font-family: 'Syne', sans-serif;
            font-weight: 800; font-size: 0.9rem; color: #fff;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(139,125,255,0.35);
        }

        .step-card h6 { font-family: 'Syne', sans-serif; font-weight: 700; color: var(--text-primary); margin-bottom: 0.3rem; font-size: 0.95rem; }
        .step-card p  { font-size: 0.86rem; color: var(--text-muted); margin: 0; line-height: 1.65; }

        /* ══════════════════════════════════════
           FAQ
        ══════════════════════════════════════ */
        .faq-item {
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            margin-bottom: 0.65rem;
            overflow: hidden;
            transition: border-color 0.22s;
        }

        .faq-item:hover { border-color: rgba(139,125,255,0.25); }

        .faq-question {
            width: 100%;
            background: var(--bg-card);
            border: none;
            color: var(--text-primary);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.93rem;
            font-weight: 600;
            padding: 1.1rem 1.35rem;
            text-align: left;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            transition: background 0.18s, color 0.18s;
        }

        .faq-question:hover { background: var(--accent-dim); }
        .faq-icon { color: var(--accent-bright); font-size: 0.8rem; transition: transform 0.32s var(--ease-out); flex-shrink: 0; }

        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s var(--ease-out), padding 0.3s ease;
            font-size: 0.875rem;
            color: var(--text-muted);
            line-height: 1.75;
            padding: 0 1.35rem;
            background: var(--bg-surface);
        }

        .faq-item.open .faq-answer    { max-height: 400px; padding: 0 1.35rem 1.15rem; }
        .faq-item.open .faq-icon      { transform: rotate(45deg); }
        .faq-item.open .faq-question  { color: var(--text-primary); background: var(--accent-dim); }

        /* ══════════════════════════════════════
           TEAM CARD
        ══════════════════════════════════════ */
        .team-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            padding: 2.5rem 2rem;
            text-align: center;
            transition: border-color 0.25s, transform 0.25s var(--ease-out), box-shadow 0.25s;
        }

        .team-card:hover { border-color: var(--border-hover); transform: translateY(-5px); box-shadow: var(--shadow-glow), var(--shadow-card); }

        .team-avatar {
            width: 84px; height: 84px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-bright));
            display: flex; align-items: center; justify-content: center;
            font-family: 'Syne', sans-serif;
            font-size: 2.2rem; font-weight: 800; color: #fff;
            margin: 0 auto 1.25rem;
            box-shadow: 0 8px 30px rgba(139,125,255,0.4);
        }

        /* ══════════════════════════════════════
           PRIVACY
        ══════════════════════════════════════ */
        .privacy-section {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 1.75rem;
            margin-bottom: 1rem;
            transition: border-color 0.2s;
        }

        .privacy-section:hover { border-color: rgba(139,125,255,0.18); }
        .privacy-section h5 { color: var(--accent-bright); font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.97rem; margin-bottom: 0.85rem; display: flex; align-items: center; gap: 0.55rem; }
        .privacy-section p, .privacy-section li { font-size: 0.875rem; color: var(--text-muted); line-height: 1.75; }
        .privacy-section ul { padding-left: 1.2rem; margin: 0.5rem 0 0; }
        .privacy-section li + li { margin-top: 0.35rem; }

        /* ══════════════════════════════════════
           BLOG CARDS
        ══════════════════════════════════════ */
        .blog-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            transition: border-color 0.25s, transform 0.25s var(--ease-out), box-shadow 0.25s;
            height: 100%;
        }

        .blog-card:hover { border-color: var(--border-hover); transform: translateY(-5px); box-shadow: var(--shadow-glow), var(--shadow-card); }

        .blog-card-img {
            height: 175px;
            background: linear-gradient(135deg, var(--bg-elevated), var(--bg-surface));
            display: flex; align-items: center; justify-content: center;
            font-size: 3.2rem;
            border-bottom: 1px solid var(--border);
        }

        .blog-card-body { padding: 1.5rem; }

        .blog-tag {
            display: inline-block;
            background: var(--accent-dim);
            border: 1px solid rgba(139,125,255,0.22);
            color: var(--accent-bright);
            font-size: 0.68rem;
            font-weight: 700;
            border-radius: 30px;
            padding: 3px 12px;
            margin-bottom: 0.8rem;
            letter-spacing: 1px;
        }

        .blog-card-body h5 { font-family: 'Syne', sans-serif; color: var(--text-primary); font-weight: 700; font-size: 0.97rem; margin-bottom: 0.55rem; line-height: 1.4; }
        .blog-card-body p  { color: var(--text-muted); font-size: 0.85rem; line-height: 1.65; margin: 0; }
        .blog-meta { font-size: 0.76rem; color: var(--text-muted); margin-top: 1rem; }

        /* ══════════════════════════════════════
           SECTION HELPERS
        ══════════════════════════════════════ */
        .section-label  { font-size: 0.69rem; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--accent-bright); margin-bottom: 0.5rem; }
        .section-title  { font-family: 'Syne', sans-serif; font-size: clamp(1.65rem, 3vw, 2.3rem); font-weight: 800; color: var(--text-primary); line-height: 1.18; margin-bottom: 1rem; }
        .section-desc   { color: var(--text-muted); font-size: 0.93rem; line-height: 1.75; max-width: 540px; }
        .purple-divider { height: 3px; width: 44px; background: linear-gradient(90deg, var(--accent), var(--accent-bright)); border-radius: 2px; margin: 0.85rem 0 1.5rem; }

        /* ══════════════════════════════════════
           BUTTONS
        ══════════════════════════════════════ */
        .btn-accent {
            background: linear-gradient(135deg, var(--accent), var(--accent-bright));
            color: #fff;
            border: none;
            border-radius: var(--radius-sm);
            font-weight: 600;
            font-size: 0.88rem;
            padding: 0.55rem 1.3rem;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.15s var(--ease-spring);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-accent:hover { opacity: 0.88; transform: translateY(-1px); color: #fff; }

        .linkedin-btn {
            background: #0a66c2;
            border: none;
            border-radius: var(--radius-sm);
            font-size: 0.86rem;
            font-weight: 600;
            padding: 0.5rem 1.2rem;
            color: #fff !important;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: background 0.2s, transform 0.15s var(--ease-spring);
        }

        .linkedin-btn:hover { background: #0856a7; transform: translateY(-1px); }

        /* ══════════════════════════════════════
           FORMS
        ══════════════════════════════════════ */
        .form-control, .form-select {
            background: var(--input-bg) !important;
            border: 1px solid var(--input-border) !important;
            color: var(--input-text) !important;
            border-radius: var(--radius-sm) !important;
            padding: 0.7rem 1rem !important;
            font-size: 0.9rem !important;
            transition: border-color 0.2s, box-shadow 0.2s !important;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--accent) !important;
            box-shadow: 0 0 0 3px var(--accent-dim) !important;
            background: var(--input-bg) !important;
            color: var(--input-text) !important;
        }

        .form-control::placeholder { color: var(--text-muted) !important; }
        .form-label { color: var(--text-secondary); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem; }

        .input-group-text {
            background: var(--bg-elevated) !important;
            border: 1px solid var(--input-border) !important;
            color: var(--accent-bright) !important;
            border-radius: var(--radius-sm) 0 0 var(--radius-sm) !important;
        }

        .form-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            padding: 2.5rem;
            box-shadow: var(--shadow-card);
            max-width: 480px;
            margin: 0 auto;
        }

        /* ══════════════════════════════════════
           FOOTER
        ══════════════════════════════════════ */
        .footer-pro {
            background: var(--bg-surface);
            color: var(--text-primary);
            padding-top: 64px;
            border-top: 1px solid var(--border);
        }

        .footer-brand-name { font-family: 'Syne', sans-serif; font-size: 1.45rem; font-weight: 800; color: var(--text-primary); }
        .footer-tagline    { font-size: 0.9rem; color: var(--text-secondary); }
        .footer-desc       { font-size: 0.85rem; color: var(--text-muted); line-height: 1.7; max-width: 300px; }
        .footer-author     { font-size: 0.85rem; font-weight: 600; color: var(--accent-bright); }
        .footer-heading    { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--accent-bright); margin-bottom: 1rem; }

        .footer-links { list-style: none; padding: 0; margin: 0; }
        .footer-links li { margin-bottom: 0.45rem; }
        .footer-links a { color: var(--text-secondary); text-decoration: none; font-size: 0.86rem; transition: color 0.18s, padding-left 0.2s; display: inline-flex; align-items: center; gap: 6px; }
        .footer-links a:hover { color: var(--accent-bright); padding-left: 4px; }

        .footer-social-icon {
            width: 34px; height: 34px;
            border-radius: var(--radius-sm);
            background: var(--bg-card);
            border: 1px solid var(--border);
            display: inline-flex; align-items: center; justify-content: center;
            color: var(--text-secondary);
            font-size: 0.9rem;
            text-decoration: none;
            transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.15s var(--ease-spring);
            margin-right: 4px;
        }

        .footer-social-icon:hover { background: var(--accent); border-color: var(--accent); color: #fff; transform: translateY(-2px); }

        .footer-divider { border-color: var(--border); margin: 40px 0 0; }

        .footer-bottom {
            padding: 18px 0;
            font-size: 0.8rem;
            color: var(--text-muted);
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: space-between;
            align-items: center;
        }

        .footer-bottom a { color: var(--accent-bright); text-decoration: none; transition: color 0.15s; }
        .footer-bottom a:hover { color: var(--text-primary); }
        .footer-bottom-links { display: flex; align-items: center; gap: 20px; }

        .footer-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(34,197,94,0.08);
            border: 1px solid rgba(34,197,94,0.2);
            border-radius: 30px;
            padding: 4px 14px;
            font-size: 0.73rem;
            font-weight: 600;
            color: #22c55e;
            margin-bottom: 1.1rem;
        }

        /* ══════════════════════════════════════
           DROPDOWN MENU (shared)
        ══════════════════════════════════════ */
        .dropdown-menu {
            background: var(--bg-elevated);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            box-shadow: 0 8px 30px rgba(0,0,0,0.4);
            padding: 0.4rem;
        }

        .dropdown-item { color: var(--text-secondary); font-size: 0.86rem; border-radius: var(--radius-sm); padding: 0.55rem 0.85rem; transition: background 0.15s, color 0.15s; }
        .dropdown-item:hover { background: var(--accent-dim); color: var(--text-primary); }
        .dropdown-divider { border-color: var(--border); margin: 0.25rem 0; }

        .alert { font-size: 0.88rem; }

        /* ══════════════════════════════════════
           RESPONSIVE
        ══════════════════════════════════════ */
        @@media (max-width: 991px) {
            .nav-center { flex-wrap: wrap; justify-content: flex-start; }
            .panel-hero { padding: 60px 0 50px; }
        }

        @@media (max-width: 576px) {
            .footer-bottom { flex-direction: column; text-align: center; gap: 8px; }
            .footer-bottom-links { flex-wrap: wrap; justify-content: center; }
            .form-card { padding: 1.75rem 1.25rem; }
        }

    </style>
</head>
