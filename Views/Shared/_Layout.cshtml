<!-- ── ABOUT ── -->
<div class="page-panel" id="panel-about">
  <div class="panel-backdrop" onclick="closePanelFromBackdrop(event, 'about')"></div>
  <div class="page-panel-inner">
    <div class="panel-topbar">
      <span class="brand"><i class="fas fa-code-branch me-2"></i>CollabNest</span>
      <button class="panel-close" onclick="closePanel('about')" title="Close (Esc)"><i class="fas fa-times"></i></button>
    </div>
